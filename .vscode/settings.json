{
  // Interpreter: the project venv made by the "Setup: create venv + install everything" task.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,

  // Tests: the suite uses unittest (no GUI or analysis tools needed).
  "python.testing.unittestEnabled": true,
  "python.testing.pytestEnabled": false,
  "python.testing.unittestArgs": ["-v", "-s", "./tests", "-p", "test_*.py"],

  // Lint/format with Ruff; settings live in pyproject.toml.
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.rulers": [120]
  },

  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "[bat]": { "files.eol": "\r\n" },

  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true
  },
  // Keep downloaded tools and analysis output out of search results.
  "search.exclude": {
    "vendor/**": true,
    "MTW_output/**": true,
    "MTW_test_suite/**": true,
    ".venv/**": true
  },
  // Never let VS Code auto-open or preview sample output.
  "files.watcherExclude": {
    "**/MTW_output/**": true,
    "**/MTW_test_suite/**": true,
    "**/.venv/**": true
  }
}
